rules_version = '2';

// CampusFix access control.
// The app hides staff features from students, but these rules are what
// actually enforce it: a student cannot change a status even with a
// modified client.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function aluEmail() {
      return request.auth.token.email.lower().matches('^[^@]+@(alustudent|alueducation)[.]com$');
    }

    // An admin added staffInvites/{email} for this account's email.
    function invitedStaff() {
      return exists(/databases/$(database)/documents/staffInvites/$(request.auth.token.email.lower()));
    }

    function invite() {
      return get(/databases/$(database)/documents/staffInvites/$(request.auth.token.email.lower())).data;
    }

    // role == 'staff' comes only from an admin: an invite or a console edit.
    function staffRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff';
    }

    // Signed in, email link opened, and either an ALU address or an
    // admin-created staff account (staff may use a non-ALU email).
    function verified() {
      return signedIn() && request.auth.token.email_verified == true
        && (aluEmail() || staffRole());
    }

    function isStaff() {
      return signedIn() && request.auth.token.email_verified == true && staffRole();
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function validDetails(d) {
      return d.title is string && d.title.size() >= 5 && d.title.size() <= 80
        && d.description is string && d.description.size() >= 15 && d.description.size() <= 1000
        && d.category in ['facilities', 'water', 'electricity', 'furniture', 'sanitation', 'safety']
        && d.location is string && d.location.size() > 0 && d.location.size() <= 100
        && d.get('locationDetail', '') is string && d.get('locationDetail', '').size() <= 100;
    }

    // ---- users/{uid} -----------------------------------------------------
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());

      // Self-registration creates a student (ALU email), or staff when an
      // admin has invited this exact email in staffInvites. The department
      // must match the invite's.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 80
        && (
          (invitedStaff()
            && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'createdAt', 'department'])
            && request.resource.data.role == 'staff'
            && request.resource.data.get('department', null) == invite().get('department', null))
          || (aluEmail()
            && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'createdAt'])
            && request.resource.data.role == 'student')
        );

      // Users may rename themselves but never change their role or email.
      allow update: if signedIn() && request.auth.uid == uid && changedOnly(['name']);
      allow delete: if false;
    }

    // ---- staffInvites/{email} --------------------------------------------
    // Added by an admin in the Firebase Console (doc ID = lower-case email,
    // optional `department`). The register screen looks up one address
    // before the account exists, so single gets are open; listing is not.
    match /staffInvites/{email} {
      allow get: if true;
      allow list, write: if false;
    }

    // ---- incidents/{id} --------------------------------------------------
    match /incidents/{id} {
      allow read: if verified();

      allow create: if verified()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'submitted'
        && request.resource.data.history.size() == 1
        && validDetails(request.resource.data);

      // Reporter edits details, only while still Submitted.
      allow update: if verified()
        && resource.data.reporterId == request.auth.uid
        && resource.data.status == 'submitted'
        && changedOnly(['title', 'description', 'category', 'location', 'locationDetail', 'photoUrl', 'photoPath', 'updatedAt'])
        && validDetails(request.resource.data);

      // Staff change the status and append exactly one timeline entry.
      allow update: if isStaff()
        && changedOnly(['status', 'history', 'updatedAt'])
        && request.resource.data.status in ['submitted', 'inProgress', 'resolved', 'rejected']
        && request.resource.data.history.size() == resource.data.history.size() + 1;

      allow delete: if verified()
        && resource.data.reporterId == request.auth.uid
        && resource.data.status == 'submitted';
    }

    // ---- notifications/{id} ----------------------------------------------
    match /notifications/{id} {
      allow read: if verified() && resource.data.userId == request.auth.uid;

      // A student writes their own "Report received"; staff notify reporters.
      allow create: if verified()
        && (request.resource.data.userId == request.auth.uid || isStaff());

      // Only flipping `read` is allowed, and only by the recipient.
      allow update: if verified() && resource.data.userId == request.auth.uid
        && changedOnly(['read']);
      allow delete: if false;
    }
  }
}
